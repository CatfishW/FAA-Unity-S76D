# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Exception: DependencyRestoreFailed.bin is generated when a dependency restore fails
!/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*/DependencyRestoreFailed.bin

# Ignore everything in the .vscode directory
/.vscode/

# Ignore .vs directory
/.vs/

# Ignore any other generated files
*.slnx
.DS_Store
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.py[cod]
*.py[cod].meta
__pycache__/

# Agent/runtime evidence and local automation artifacts
/_artifacts/
/_remote_verification/
/.sisyphus/
/ops/
/test-results/
/ulw_test_results/
/dashboard-live.png
/wx-live.png
/steam-*.png
/xplane-*.png
/xplane-*.ppm
/xplane-*.xwd

# Local Unity recovery/crash output
/EmbeddedProjectRecovery_Library/
/unity-gui-run.log
/mono_crash.*

# Unity screenshots generated by FAA HUD/X-Plane validation runs.
# Curated screenshots already tracked under Assets/Screenshots remain tracked.
/Assets/_Project/Verification/
/Assets/Screenshots/faa-*.png
/Assets/Screenshots/faa-*.png.meta

# Imported editor samples and local visual-validation captures. The XR setup
# tool can import/copy the required sample prefab on a development machine.
/Assets/Samples/
/Assets/Samples.meta
/Assets/Temp/
/Assets/Temp.meta
/Assets/_Recovery/

# Codex/editor recovery state is machine-local. Source-level release notes and
# reproducible verification tools belong in docs/ and Tools/ instead.
/.agent/
/_codex_backups/
/EmbeddedProjectRecovery_*/
/unity_latest.png

# Package-created local settings that are not part of the product profile.
/ProjectSettings/PhysicsCoreProjectSettings2D.asset
/ProjectSettings/ProjectAuditorSettings.asset
