[Unit]
Description=FAA S76 X-Plane native-autopilot flight demonstration
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/faa-s76-flight
ExecStart=/usr/bin/python3 -u %h/.local/share/faa-s76-flight/flight_demo.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/faa-s76-flight
MemoryMax=128M

[Install]
WantedBy=default.target
